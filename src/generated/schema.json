  "UPDATE_SPATIAL_VOICE_SESSION": {
    "request": {
      "type": "object",
      "description": "Request for \"UPDATE_SPATIAL_VOICE_SESSION\" Command",
      "properties": {
        "session_id": {"type": "string"},
        "listener": {
          "type": "object",
          "properties": {
            "position": {
              "type": "object",
              "properties": {
                "x": {"type": "number", "minimum": -100000, "maximum": 100000},
                "y": {"type": "number", "minimum": -100000, "maximum": 100000},
                "z": {"type": "number", "minimum": -100000, "maximum": 100000}
              },
              "required": ["x", "y", "z"],
              "additionalProperties": false
            },
            "forward": {
              "type": "object",
              "properties": {
                "x": {"type": "number", "minimum": -100000, "maximum": 100000},
                "y": {"type": "number", "minimum": -100000, "maximum": 100000},
                "z": {"type": "number", "minimum": -100000, "maximum": 100000}
              },
              "required": ["x", "y", "z"],
              "additionalProperties": false
            }
          },
          "required": ["position", "forward"],
          "additionalProperties": false
        },
        "sources": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "properties": {
              "user_id": {"type": "string"},
              "position": {
                "type": "object",
                "properties": {
                  "x": {"type": "number", "minimum": -100000, "maximum": 100000},
                  "y": {"type": "number", "minimum": -100000, "maximum": 100000},
                  "z": {"type": "number", "minimum": -100000, "maximum": 100000}
                },
                "required": ["x", "y", "z"],
                "additionalProperties": false
              },
              "gain": {"type": "number", "minimum": 0, "maximum": 1},
              "spatial_blend": {"type": "number", "minimum": 0, "maximum": 1}
            },
            "required": ["user_id", "position", "gain", "spatial_blend"],
            "additionalProperties": false
          }
        }
      },
      "required": ["session_id", "listener", "sources"],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "description": "Response for \"UPDATE_SPATIAL_VOICE_SESSION\" Command",
      "properties": {"success": {"type": "boolean"}},
      "required": ["success"],
      "additionalProperties": false
    }
  },
